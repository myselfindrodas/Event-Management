rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidEvent() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'title', 'description', 'dateTime', 'location', 'userId', 'createdAt', 'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.description is string
        && data.description.size() <= 2000
        && data.location is string
        && data.location.size() <= 200
        && data.dateTime is timestamp
        && data.userId == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDevice() {
      let data = request.resource.data;
      return data.keys().hasOnly(['token', 'platform', 'updatedAt'])
        && data.token is string
        && data.token.size() > 0
        && data.platform is string
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/events/{eventId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidEvent();
      allow update: if isOwner(userId)
        && isValidEvent()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'description', 'dateTime', 'location', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/devices/{deviceId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidDevice();
      allow delete: if isOwner(userId);
    }
  }
}
