<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_brand_gradient">

    <View
        android:id="@+id/ringOuter"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_splash_ring"
        app:layout_constraintBottom_toBottomOf="@id/logoHolder"
        app:layout_constraintEnd_toEndOf="@id/logoHolder"
        app:layout_constraintStart_toStartOf="@id/logoHolder"
        app:layout_constraintTop_toTopOf="@id/logoHolder" />

    <View
        android:id="@+id/ringInner"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/bg_splash_ring"
        app:layout_constraintBottom_toBottomOf="@id/logoHolder"
        app:layout_constraintEnd_toEndOf="@id/logoHolder"
        app:layout_constraintStart_toStartOf="@id/logoHolder"
        app:layout_constraintTop_toTopOf="@id/logoHolder" />

    <FrameLayout
        android:id="@+id/logoHolder"
        android:layout_width="116dp"
        android:layout_height="116dp"
        android:background="@drawable/bg_circle_translucent"
        app:layout_constraintBottom_toTopOf="@id/tvBrand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_brand_logo"
            android:src="@drawable/ic_event_brand" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/poppins_bold"
        android:letterSpacing="0.01"
        android:text="@string/app_name"
        android:textColor="@color/on_brand"
        android:textSize="32sp"
        app:layout_constraintBottom_toTopOf="@id/tvTagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoHolder" />

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill_translucent"
        android:fontFamily="@font/poppins_medium"
        android:paddingHorizontal="18dp"
        android:paddingVertical="7dp"
        android:text="@string/splash_tagline"
        android:textColor="@color/on_brand"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBrand" />

    <LinearLayout
        android:id="@+id/loaderDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="56dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/dot1"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/bg_circle_translucent" />

        <View
            android:id="@+id/dot2"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/bg_circle_translucent" />

        <View
            android:id="@+id/dot3"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/bg_circle_translucent" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
