<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/dashboardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="32dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_gradient"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_circle_translucent"
                android:contentDescription="@string/cd_profile_avatar"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:textColor="@color/on_brand"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="A" />

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/on_brand"
                android:textSize="22sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvAvatar"
                app:layout_constraintTop_toTopOf="@id/tvAvatar"
                tools:text="Good morning" />

            <TextView
                android:id="@+id/tvUserLine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_regular"
                android:maxLines="1"
                android:textColor="@color/on_brand_muted"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/tvGreeting"
                app:layout_constraintTop_toBottomOf="@id/tvGreeting"
                tools:text="Today is Monday, 22 September" />

            <FrameLayout
                android:id="@+id/ringHolder"
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:layout_marginTop="22dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAvatar">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressCompletion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    app:indicatorColor="@color/on_brand"
                    app:indicatorDirectionCircular="clockwise"
                    app:indicatorSize="92dp"
                    app:trackColor="@color/brand_overlay"
                    app:trackCornerRadius="8dp"
                    app:trackThickness="8dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCompletionValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:textColor="@color/on_brand"
                        android:textSize="20sp"
                        tools:text="62%" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:includeFontPadding="false"
                        android:text="@string/completion_label"
                        android:textColor="@color/on_brand_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@id/ringHolder"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ringHolder"
                app:layout_constraintTop_toTopOf="@id/ringHolder">

                <TextView
                    android:id="@+id/tvHeroPlanned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_translucent"
                    android:drawablePadding="7dp"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:textColor="@color/on_brand"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_layers"
                    app:drawableTint="@color/on_brand"
                    tools:text="12 planned" />

                <TextView
                    android:id="@+id/tvHeroWeek"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_pill_translucent"
                    android:drawablePadding="7dp"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:textColor="@color/on_brand"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_trending_up"
                    app:drawableTint="@color/on_brand"
                    tools:text="3 this week" />

                <TextView
                    android:id="@+id/tvCompletionCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/on_brand_muted"
                    android:textSize="11sp"
                    tools:text="8 of 13 events have already taken place" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/labelOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_overview"
            android:textAppearance="@style/TextAppearance.EventManagement.Title" />

        <LinearLayout
            android:id="@+id/statRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/surface_container_low"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_icon_chip"
                        android:backgroundTint="@color/primary_container"
                        android:contentDescription="@string/cd_stat_icon"
                        android:padding="7dp"
                        android:src="@drawable/ic_layers"
                        app:tint="@color/on_primary_container" />

                    <TextView
                        android:id="@+id/tvTotalEvents"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/stat_zero"
                        android:textColor="@color/on_surface"
                        android:textSize="26sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/total_events"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUpcoming"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/surface_container_low"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_icon_chip"
                        android:backgroundTint="@color/success_container"
                        android:contentDescription="@string/cd_stat_icon"
                        android:padding="7dp"
                        android:src="@drawable/ic_trending_up"
                        app:tint="@color/success" />

                    <TextView
                        android:id="@+id/tvUpcomingEvents"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/stat_zero"
                        android:textColor="@color/on_surface"
                        android:textSize="26sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/upcoming_events"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/surface_container_low"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_icon_chip"
                        android:backgroundTint="@color/warning_container"
                        android:contentDescription="@string/cd_stat_icon"
                        android:padding="7dp"
                        android:src="@drawable/ic_history"
                        app:tint="@color/warning" />

                    <TextView
                        android:id="@+id/tvPastEvents"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/stat_zero"
                        android:textColor="@color/on_surface"
                        android:textSize="26sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/past_events"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:id="@+id/labelNextEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/next_event"
            android:textAppearance="@style/TextAppearance.EventManagement.Title" />

        <LinearLayout
            android:id="@+id/cardNextEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_next_event_gradient"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_translucent"
                android:drawablePadding="6dp"
                android:fontFamily="@font/poppins_semibold"
                android:paddingHorizontal="13dp"
                android:paddingVertical="6dp"
                android:textColor="@color/on_brand"
                android:textSize="11sp"
                app:drawableStartCompat="@drawable/ic_sparkle"
                app:drawableTint="@color/on_brand"
                tools:text="In 3 days" />

            <TextView
                android:id="@+id/tvNextTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="2"
                android:text="@string/no_upcoming_event"
                android:textColor="@color/on_brand"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/tvNextDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawablePadding="9dp"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/no_upcoming_event_hint"
                android:textColor="@color/on_brand_muted"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_calendar"
                app:drawableTint="@color/on_brand_muted" />

            <TextView
                android:id="@+id/tvNextLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:drawablePadding="9dp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/on_brand_muted"
                android:textSize="13sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_location"
                app:drawableTint="@color/on_brand_muted"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/labelWeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/week_ahead"
            android:textAppearance="@style/TextAppearance.EventManagement.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/week_ahead_hint"
            android:textAppearance="@style/TextAppearance.EventManagement.Body" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface_container_low"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/weekStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="18dp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/labelInsights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_insights"
            android:textAppearance="@style/TextAppearance.EventManagement.Title" />

        <LinearLayout
            android:id="@+id/insightRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/accent_violet_container"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="7dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/insight_busiest_month"
                        android:textColor="@color/accent_violet"
                        android:textSize="11sp"
                        app:drawableStartCompat="@drawable/ic_sparkle"
                        app:drawableTint="@color/accent_violet" />

                    <TextView
                        android:id="@+id/tvBusiestMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/insight_none"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/accent_cyan_container"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="7dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/insight_weekly_average"
                        android:textColor="@color/accent_cyan"
                        android:textSize="11sp"
                        app:drawableStartCompat="@drawable/ic_trending_up"
                        app:drawableTint="@color/accent_cyan" />

                    <TextView
                        android:id="@+id/tvMonthlyAverage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/insight_none"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:id="@+id/labelChart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/monthly_activity"
            android:textAppearance="@style/TextAppearance.EventManagement.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/monthly_activity_hint"
            android:textAppearance="@style/TextAppearance.EventManagement.Body" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChart"
            android:layout_width="match_parent"
            android:layout_height="290dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface_container_low"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline_variant"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/chartEmptyGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:alpha="0.85"
                        android:contentDescription="@string/cd_empty_illustration"
                        android:src="@drawable/ic_empty_calendar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/no_chart_data"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/surface_container_high"
            app:trackCornerRadius="4dp"
            app:trackThickness="4dp"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
